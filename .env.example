# Anthropic and Gemini API keys are NOT read from environment variables.
# Set them via the admin panel (/admin.html) after first deploy - the
# database is the single source of truth for both keys.

# Postgres connection string (Neon via Vercel Storage, or any Postgres).
# Required - the app will not start without it.
POSTGRES_URL=

# Server port (optional, defaults to 3000)
PORT=3000
