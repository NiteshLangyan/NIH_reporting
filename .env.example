# Anthropic API Key - used to seed the DB on first run only. After that,
# manage keys via the admin panel (/admin.html) instead of this file.
ANTHROPIC_API_KEY=

# Google Gemini API Key - same one-time seeding note as above.
GEMINI_API_KEY=

# Postgres connection string (Neon via Vercel Storage, or any Postgres).
# Required - the app will not start without it.
POSTGRES_URL=

# Server port (optional, defaults to 3000)
PORT=3000
